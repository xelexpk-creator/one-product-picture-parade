{
  "info": {
    "name": "Xelex Order API",
    "description": "Store, coupon, checkout, customer, order, and payment endpoints. Run Admin login to populate adminToken for protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/admin/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data.token) pm.collectionVariables.set(\"adminToken\", data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get store settings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/store/settings"
      }
    },
    {
      "name": "Update store settings",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actualPrice\": 5499,\n  \"sellingPrice\": 4999,\n  \"shippingCharges\": 200,\n  \"freeShippingAbove\": 10000,\n  \"codEnabled\": true,\n  \"onlinePaymentEnabled\": true,\n  \"isAvailable\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/store/settings"
      }
    },
    {
      "name": "Create coupon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"XELEX500\",\n  \"discountType\": \"FIXED\",\n  \"discountValue\": 500,\n  \"minOrderAmount\": 3000,\n  \"maxDiscount\": 1000,\n  \"usageLimit\": 100,\n  \"usedCount\": 0,\n  \"startDate\": null,\n  \"expiryDate\": null,\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/coupons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data._id || data.id) pm.collectionVariables.set(\"couponId\", data._id || data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List coupons",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/coupons"
      }
    },
    {
      "name": "Update coupon",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"XELEX500\",\n  \"discountType\": \"FIXED\",\n  \"discountValue\": 500,\n  \"minOrderAmount\": 3000,\n  \"maxDiscount\": 1000,\n  \"usageLimit\": 100,\n  \"usedCount\": 0,\n  \"startDate\": null,\n  \"expiryDate\": null,\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/coupons/{{couponId}}"
      }
    },
    {
      "name": "Delete coupon",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/coupons/{{couponId}}"
      }
    },
    {
      "name": "Validate coupon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"XELEX500\",\n  \"orderAmount\": 5000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/coupons/validate"
      }
    },
    {
      "name": "Calculate checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 1,\n  \"couponCode\": \"XELEX500\",\n  \"city\": \"Karachi\",\n  \"province\": \"Sindh\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/checkout/calculate"
      }
    },
    {
      "name": "List customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/customers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data.items && data.items.length && data.items[0]._id) pm.collectionVariables.set(\"customerId\", data.items[0]._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get customer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/customers/{{customerId}}"
      }
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": {\n    \"fullName\": \"Test Customer\",\n    \"phone\": \"+923001234567\",\n    \"email\": \"customer@example.com\"\n  },\n  \"quantity\": 1,\n  \"couponCode\": \"XELEX500\",\n  \"paymentMethod\": \"COD\",\n  \"shippingAddress\": {\n    \"address\": \"123 Main Street\",\n    \"area\": \"Gulshan-e-Iqbal\",\n    \"city\": \"Karachi\",\n    \"province\": \"Sindh\",\n    \"postalCode\": \"75300\",\n    \"country\": \"Pakistan\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data.data && data.data.id) pm.collectionVariables.set(\"orderId\", data.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get dashboard stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/dashboard/stats"
      }
    },
    {
      "name": "Get recent dashboard orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/dashboard/recent-orders"
      }
    },
    {
      "name": "Get dashboard sales",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/dashboard/sales?period=7days"
      }
    },
    {
      "name": "Get dashboard order summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/dashboard/order-summary"
      }
    },
    {
      "name": "List orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data.items && data.items.length && data.items[0]._id) pm.collectionVariables.set(\"orderId\", data.items[0]._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Track order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderNumber\": \"XLX-2026-000001\",\n  \"phone\": \"03001234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders/track"
      }
    },
    {
      "name": "Get order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/orders/{{orderId}}"
      }
    },
    {
      "name": "Get order status history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/history"
      }
    },
    {
      "name": "Update order status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderStatus\": \"CONFIRMED\",\n  \"reason\": \"Confirmed by admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status"
      }
    },
    {
      "name": "Cancel order",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cancellationReason\": \"Customer requested cancellation\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/cancel"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "couponId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ]
}